{
  "id": "linuxbrew",
  "version": "1.0.0",
  "name": "Linuxbrew",
  "description": "Installs Homebrew on Linux under /home/linuxbrew/.linuxbrew.",
  "documentationURL": "https://github.com/jasonchaffee/devcontainers/tree/main/features/linuxbrew",
  "dependsOn": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "containerEnv": {
    "HOMEBREW_PREFIX": "/home/linuxbrew/.linuxbrew",
    "HOMEBREW_CELLAR": "/home/linuxbrew/.linuxbrew/Cellar",
    "HOMEBREW_REPOSITORY": "/home/linuxbrew/.linuxbrew/Homebrew",
    "PATH": "/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${PATH}"
  },
  "options": {
    "installPackages": {
      "type": "string",
      "default": "",
      "description": "Space-separated Homebrew packages to install after brew is available."
    }
  }
}
