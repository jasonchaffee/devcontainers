{
  // ==========================================================================
  // Python Dev Container Template
  // ==========================================================================
  // Copy to your project's .devcontainer/devcontainer.json and customize.
  // See: https://containers.dev/implementors/json_reference/
  // ==========================================================================

  "name": "Python Development",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },

  // --------------------------------------------------------------------------
  // Features
  // --------------------------------------------------------------------------
  "features": {
    // =========================================================================
    // Official Features
    // =========================================================================
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "${templateOption:pythonVersion}"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},

    // =========================================================================
    // Custom Features
    // =========================================================================
    "ghcr.io/jasonchaffee/devcontainers/uv:1": {},
    "ghcr.io/jasonchaffee/devcontainers/antidote:1": {},
    "ghcr.io/jasonchaffee/devcontainers/bun:1": {},
    "ghcr.io/jasonchaffee/devcontainers/linuxbrew:1.0.3": {},
    "ghcr.io/jasonchaffee/devcontainers/modern-cli:1": {},
    "ghcr.io/jasonchaffee/devcontainers/shell-dev:1": {},
    "ghcr.io/jasonchaffee/devcontainers/http-tools:1": {},
    "ghcr.io/jasonchaffee/devcontainers/terminal-extras:1": {},

    // AI Tools
    "ghcr.io/jasonchaffee/devcontainers/claude-code:1": {
      "version": "${templateOption:claudeCodeVersion}",
      "installStatusLine": false
    },
    "ghcr.io/jasonchaffee/devcontainers/codex:1": {
      "version": "latest"
    },
    "ghcr.io/jasonchaffee/devcontainers/gemini-cli:1": {
      "version": "${templateOption:geminiVersion}"
    }

    // =========================================================================
    // Optional — uncomment as needed
    // =========================================================================
    // "ghcr.io/jasonchaffee/devcontainers/gcloud-cli:1": { "version": "latest" },
    // "ghcr.io/grafana/devcontainer-features/k6:1": {},
    // "ghcr.io/jasonchaffee/devcontainers/locust:1": {}
  },

  // --------------------------------------------------------------------------
  // IDE Customizations
  // --------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",

        // Git
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "github.vscode-pull-request-github",

        // Code quality
        "esbenp.prettier-vscode",
        "usernamehw.errorlens",
        "streetsidesoftware.code-spell-checker",

        // Shell
        "timonwong.shellcheck",
        "jetmartin.bats",

        // Utilities
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "gruntfuggly.todo-tree",
        "github.vscode-github-actions",

        // AI Tools
        "anthropic.claude-code",
        "openai.chatgpt",
        "github.copilot",
        "google.geminicodeassist"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "remote.autoForwardPorts": false,
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },

  // --------------------------------------------------------------------------
  // Environment Variables
  // --------------------------------------------------------------------------
  "remoteEnv": {
    "ANTHROPIC_API_KEY":  "${localEnv:ANTHROPIC_API_KEY}",
    "ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
    "ANTHROPIC_AUTH_TOKEN": "${localEnv:ANTHROPIC_AUTH_TOKEN}",
    "ANTHROPIC_MODEL":    "${localEnv:ANTHROPIC_MODEL}",
    "DISABLE_AUTOUPDATER": "${localEnv:DISABLE_AUTOUPDATER}",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "${localEnv:CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS}",
    "OPENAI_API_KEY":     "${localEnv:OPENAI_API_KEY}",
    "OPENAI_BASE_URL":    "${localEnv:OPENAI_BASE_URL}",
    "GEMINI_API_KEY":     "${localEnv:GEMINI_API_KEY}",
    "GEMINI_BASE_URL":    "${localEnv:GEMINI_BASE_URL}",
    "GOOGLE_CLOUD_PROJECT": "${localEnv:GOOGLE_CLOUD_PROJECT}",
    "GITHUB_TOKEN":       "${localEnv:GITHUB_TOKEN}"
  },

  // --------------------------------------------------------------------------
  // Mounts
  // --------------------------------------------------------------------------
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly",
    "source=${localWorkspaceFolderBasename}-shellhistory,target=/commandhistory,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude-json-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.gemini,target=/home/vscode/.gemini-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.cursor,target=/home/vscode/.cursor-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.junie,target=/home/vscode/.junie-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.openclaude,target=/home/vscode/.openclaude-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.antigravity,target=/home/vscode/.antigravity-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.config/opencode,target=/home/vscode/.config/opencode-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.mcp-auth,target=/home/vscode/.mcp-auth-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.local/share/thalamus,target=/home/vscode/.local/share/thalamus-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.claude/cost-history.jsonl,target=/home/vscode/.ai-writeback/claude-cost-history.jsonl,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude/cost-mode,target=/home/vscode/.ai-writeback/claude-cost-mode,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude/memory,target=/home/vscode/.ai-writeback/claude-memory,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex/memory,target=/home/vscode/.ai-writeback/codex-memory,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex/memories,target=/home/vscode/.ai-writeback/codex-memories,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gemini/memory,target=/home/vscode/.ai-writeback/gemini-memory,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gemini/antigravity/memory,target=/home/vscode/.ai-writeback/gemini-antigravity-memory,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cursor/memory,target=/home/vscode/.ai-writeback/cursor-memory,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.junie/memory,target=/home/vscode/.ai-writeback/junie-memory,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.openclaude/memory,target=/home/vscode/.ai-writeback/openclaude-memory,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/opencode/memory,target=/home/vscode/.ai-writeback/opencode-memory,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.engram/spool/vector,target=/home/vscode/.ai-writeback/engram-spool-vector,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/antidote,target=/home/vscode/.antidote-cache-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.zshrc,target=/home/vscode/.zshrc,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.zprofile,target=/home/vscode/.zprofile,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.zsh_plugins.txt,target=/home/vscode/.zsh_plugins.txt,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.vimrc,target=/home/vscode/.vimrc,type=bind,consistency=cached,readonly"
  ],

  // --------------------------------------------------------------------------
  // Lifecycle Commands
  // --------------------------------------------------------------------------
  "initializeCommand": "mkdir -p ~/.claude/memory ~/.gemini/memory ~/.gemini/antigravity/memory ~/.mcp-auth ~/.antigravity ~/.claude ~/.codex/memory ~/.codex/memories ~/.cursor/memory ~/.junie/memory ~/.openclaude/memory ~/.config/opencode/memory ~/.config/gh ~/.cache/antidote ~/.engram/spool/vector ~/.local/share/thalamus ~/.ssh && touch ~/.claude.json ~/.claude/cost-history.jsonl ~/.claude/cost-mode ~/.gitconfig ~/.zshrc ~/.zprofile ~/.zsh_plugins.txt ~/.vimrc",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": ".devcontainer/post-start.sh",

  // IntelliJ/JetBrains Gateway ignores the default workspace path unless workspaceMount
  // and workspaceFolder are explicitly set (mounts at /IdeaProjects otherwise). Repo name
  // is included (not bare /workspace) so a multi-repo devcontainer.json can mount related
  // repos as siblings under /workspace without changing this path — see DEVCONTAINER.md.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",

  "remoteUser": "vscode"
}
